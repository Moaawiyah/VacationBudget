# Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Project Settings -> API -> service_role secret.
# Server-only. Never prefix this with NEXT_PUBLIC_. Required for username
# login and signup duplicate checks; never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app, used to build the email-confirmation redirect link.
# Local dev default is fine as-is; set the real Railway URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, dev only: comma-separated local IPs allowed to load dev-server
# JS bundles when testing from another device on the same WiFi network
# (feeds allowedDevOrigins in next.config.ts). Production is unaffected.
# Example: DEV_ALLOWED_ORIGINS=10.0.0.25
DEV_ALLOWED_ORIGINS=

# Receipt Intelligence: the standalone Python service (see receipt-service/)
# that does OCR + LLM extraction for uploaded receipts. Server-only — never
# prefix these with NEXT_PUBLIC_. RECEIPT_SERVICE_TOKEN must match that
# service's own SERVICE_AUTH_TOKEN (generate with: openssl rand -hex 32).
RECEIPT_SERVICE_URL=http://localhost:8000
RECEIPT_SERVICE_TOKEN=

# VacationBudget AI (budget planner, trip copilot, spending insights) —
# Groq's OpenAI-compatible chat-completions API, called directly from this
# app (a separate account/deployment from receipt-service's own GROQ_*, even
# though the var names match). Server-only — never prefix with NEXT_PUBLIC_.
# Optional: every AI feature degrades to "unavailable" without it; nothing
# else in the app is affected. GROQ_MODEL must be a tool-calling-capable
# model on Groq's current tier — check console.groq.com/docs/models.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=20000
