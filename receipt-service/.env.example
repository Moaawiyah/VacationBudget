# Groq (https://console.groq.com) — required for LLM extraction.
GROQ_API_KEY=
# Any model currently on Groq's FREE tier. Check console.groq.com/docs/models
# for what's current — Groq's free-tier lineup changes over time. This is a
# reasonable default as of writing, not a guarantee.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=20

# Shared secret the Next.js server sends as `Authorization: Bearer <token>`.
# This service trusts that header alone to authorize a request — never expose
# it to a browser. Generate one with: openssl rand -hex 32
SERVICE_AUTH_TOKEN=

# Comma-separated origins allowed to call this service directly. Normally
# empty — the Next.js server calls it server-to-server, never a browser.
ALLOWED_ORIGINS=

MAX_UPLOAD_MB=15
LOG_LEVEL=info

# LLM resilience: per-attempt timeout, retry cap, and overall deadline.
# Only timeouts, 429s and 5xx are retried; bad keys/models never are.
LLM_MAX_ATTEMPTS=3
LLM_DEADLINE_SECONDS=45
